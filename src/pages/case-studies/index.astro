---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

const studies = (await getCollection('case-studies')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="Case Studies">
	<Header />
	<main>
		<h1>Case Studies</h1>
		<p>Real incident investigations, genericized: no company or system names, just the reasoning.</p>

		<ul class="list">
			{studies.map((s) => (
				<li>
					<a href={`/case-studies/${s.id}/`}>{s.data.title}</a>
					<p>{s.data.description}</p>
				</li>
			))}
		</ul>
	</main>
</BaseLayout>

<style>
	.list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.list a {
		text-decoration: none;
		font-size: 1.15rem;
		font-weight: 600;
	}

	.list p {
		margin: 0.35rem 0 0;
		color: var(--muted, #666);
	}
</style>
