---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';

const studies = (await getCollection('case-studies')).sort(
	(a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout title="Case Studies">
	<Header />
	<main>
		<h1>Case Studies</h1>
		<p>Real incident investigations, genericized: no company or system names, just the reasoning.</p>
		<p>A pattern runs through most of these: a single report becomes the seed for finding every account affected by the same root cause, not just the one that got reported.</p>

		<ul class="list">
			{studies.map((s) => (
				<li>
					<a class="closed-card" href={`/case-studies/${s.id}/`}>
						<span class="title">{s.data.title}</span>
						<span class="chevron" aria-hidden="true">&rarr;</span>
					</a>
				</li>
			))}
		</ul>
	</main>
</BaseLayout>

<style>
	.list {
		list-style: none;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.closed-card {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 1.1rem 1.25rem;
		border: 1px solid var(--border, #ddd);
		border-radius: 10px;
		text-decoration: none;
	}

	.closed-card .title {
		font-size: 1.1rem;
		font-weight: 600;
	}

	.closed-card .chevron {
		opacity: 0.5;
		transition: transform 0.15s ease, opacity 0.15s ease;
	}

	.closed-card:hover .chevron {
		opacity: 1;
		transform: translateX(3px);
	}
</style>
