---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const story =
	"When a silent race condition surfaced, I realized fixing just the reported incident wasn't enough. I audited the entire platform to find every historically affected account. The logs were too noisy to spot the bug directly, so I used the time gaps between events to filter out false positives. We found and remediated 10,000+ real incidents out of 50,000+ candidate records, strengthening customer trust since many affected transactions were resolved before customers ever raised a complaint.";

const stats = [
	{ value: '74%', label: 'MTTR cut (35m → 9m) by building an observability-as-code platform with custom SLIs' },
	{ value: '99.95%+', label: 'Uptime maintained for a payments platform processing 10M+ daily transactions' },
	{ value: '28%', label: 'Cloud spend cut (~$120K+/yr) through automated FinOps tooling' },
];

const cards = [
	{ title: 'Case Studies', description: 'Real incident investigations, genericized.', href: '/case-studies' },
	{ title: 'Projects', description: 'Live, runnable tools and demos.', href: import.meta.env.PUBLIC_PROJECTS_URL },
	{ title: 'LinkedIn', description: 'Experience, roles, background.', href: import.meta.env.PUBLIC_LINKEDIN_URL },
];
---

<BaseLayout title="Staff-level SRE / Platform Engineer">
	<Header />
	<main>
		<h1>Idimmachukwu Okoro</h1>
		<p class="tagline">Staff-level SRE / Platform Engineer at Moniepoint, specializing in payments-systems reliability at scale.</p>

		<p class="story">{story}</p>

		<div class="stats">
			{stats.map((s) => (
				<div class="stat">
					<span class="stat-value">{s.value}</span>
					<span class="stat-label">{s.label}</span>
				</div>
			))}
		</div>

		<div class="cards">
			{cards.map((c) => (
				<a class="card" href={c.href}>
					<h2>{c.title}</h2>
					<p>{c.description}</p>
				</a>
			))}
		</div>
	</main>
</BaseLayout>

<style>
	h1 {
		margin-top: 0;
	}

	.tagline {
		font-size: 1.2rem;
		color: var(--muted);
		margin: 0 0 2rem;
		max-width: 46ch;
	}

	.story {
		font-size: 1.05rem;
		line-height: 1.65;
		color: var(--fg);
		margin: 0 0 2.5rem;
		padding-left: 1.1rem;
		border-left: 2px solid var(--border);
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1.75rem;
		margin: 0 0 3rem;
		padding: 1.75rem 0;
		border-top: 1px solid var(--border);
		border-bottom: 1px solid var(--border);
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
	}

	.stat-value {
		font-size: 2rem;
		font-weight: 800;
		letter-spacing: -0.02em;
		font-variant-numeric: tabular-nums;
		background: var(--gradient);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.stat-label {
		font-size: 0.88rem;
		color: var(--muted);
		line-height: 1.5;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.25rem;
	}

	.card {
		display: block;
		position: relative;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		padding: 1.5rem 1.5rem 1.75rem;
		text-decoration: none;
		background: var(--surface);
		box-shadow: var(--shadow-sm);
		transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
		overflow: hidden;
	}

	.card::before {
		content: '';
		position: absolute;
		inset: 0 0 auto 0;
		height: 3px;
		background: var(--gradient);
		opacity: 0.35;
		transition: opacity 0.2s ease;
	}

	.card:hover {
		transform: translateY(-4px);
		border-color: transparent;
		box-shadow: var(--shadow-lg);
	}

	.card:hover::before {
		opacity: 1;
	}

	.card h2 {
		margin: 0 0 0.5rem;
		font-size: 1.1rem;
		font-weight: 700;
	}

	.card h2::after {
		content: ' →';
		display: inline-block;
		opacity: 0;
		margin-left: -6px;
		transition: opacity 0.2s ease, margin-left 0.2s ease;
	}

	.card:hover h2::after {
		opacity: 1;
		margin-left: 2px;
	}

	.card p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--muted);
		line-height: 1.5;
	}
</style>
