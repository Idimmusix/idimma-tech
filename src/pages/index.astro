---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';

const bullets = [
	'Own reliability for a multi-service, multi-provider payments platform handling real-time inbound and outbound transfers at national-switch scale.',
	'Lead incident investigations across distributed systems — from tail-latency anomalies to cross-service dependency failures — with a bias toward root-cause clarity over guesswork.',
	'Build observability and reliability tooling — multi-backend query CLIs, SLO/alerting design — treating platform tooling as a product, not a chore.',
	'Apply the same reliability discipline to AI/agentic systems: cost-aware context design, cache-efficient scheduling, and treating LLM tooling like any other production dependency.',
];

const cards = [
	{ title: 'Case Studies', description: 'Real incident investigations, genericized.', href: '/case-studies' },
	{ title: 'Projects', description: 'Live, runnable tools and demos.', href: 'https://sre-projects.idimma.tech' },
	{ title: 'Resume / LinkedIn', description: 'Experience, roles, background.', href: 'https://linkedin.com/in/idimma' },
];
---

<BaseLayout title="Staff-level SRE / Platform Engineer">
	<Header />
	<main>
		<h1>Idimmachukwu Okoro</h1>
		<p class="tagline">Staff-level SRE / Platform Engineer specializing in payments-systems reliability at scale.</p>

		<ul class="bullets">
			{bullets.map((b) => <li>{b}</li>)}
		</ul>

		<div class="cards">
			{cards.map((c) => (
				<a class="card" href={c.href}>
					<h2>{c.title}</h2>
					<p>{c.description}</p>
				</a>
			))}
		</div>
	</main>
</BaseLayout>

<style>
	h1 {
		margin-bottom: 0.25rem;
	}

	.tagline {
		font-size: 1.15rem;
		opacity: 0.85;
		margin-top: 0;
	}

	.bullets {
		padding-left: 1.25rem;
		margin: 2rem 0;
	}

	.bullets li {
		margin-bottom: 0.75rem;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1rem;
		margin-top: 2.5rem;
	}

	.card {
		display: block;
		border: 1px solid currentColor;
		border-radius: 8px;
		padding: 1.25rem;
		text-decoration: none;
		opacity: 0.9;
	}

	.card:hover {
		opacity: 1;
	}

	.card h2 {
		margin: 0 0 0.4rem;
		font-size: 1.05rem;
	}

	.card p {
		margin: 0;
		font-size: 0.9rem;
		opacity: 0.75;
	}
</style>
